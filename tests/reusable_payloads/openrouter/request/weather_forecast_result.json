{
  "method": "POST",
  "url": "https://openrouter.ai/api/v1/chat/completions",
  "headers": {
    "authorization": "Bearer test-key",
    "content-type": "application/json"
  },
  "json": {
    "model": "test/test-model",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "forecast",
          "description": "The forecast for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "alerts",
          "description": "Weather alerts for a city.",
          "parameters": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              }
            },
            "required": [
              "city"
            ]
          }
        }
      },
      {
        "type": "function",
        "function": {
          "name": "report",
          "description": "Today's weather report.",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      }
    ],
    "messages": [
      {
        "role": "system",
        "content": "Answer briefly."
      },
      {
        "role": "user",
        "content": "What is the weather in Paris?"
      },
      {
        "role": "assistant",
        "tool_calls": [
          {
            "id": "call_1",
            "type": "function",
            "function": {
              "name": "forecast",
              "arguments": "{\"city\":\"Paris\"}"
            }
          }
        ],
        "reasoning": "Need the forecast.",
        "reasoning_details": [
          {
            "type": "reasoning.text",
            "text": "Need the forecast.",
            "format": "unknown",
            "index": 0
          }
        ]
      },
      {
        "role": "tool",
        "tool_call_id": "call_1",
        "content": "Sunny.\n21°C at noon."
      }
    ],
    "stream": true
  }
}
