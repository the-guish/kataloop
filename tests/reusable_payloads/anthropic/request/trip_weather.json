{
  "method": "POST",
  "url": "https://api.anthropic.com/v1/messages",
  "headers": {
    "x-api-key": "test-key",
    "anthropic-version": "2023-06-01",
    "content-type": "application/json"
  },
  "json": {
    "model": "test-model",
    "max_tokens": 16000,
    "system": "Answer briefly.",
    "messages": [
      {
        "role": "user",
        "content": "Some notes for my trip: four days in Paris in May, flying in from Lisbon on the 12th and back on the 16th; a budget of 2,000 euros; a hotel near the Louvre; my sister Ana joins on the 14th. I want to see the Musee d'Orsay, Montmartre and a jazz club. Which day suits Montmartre best?"
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "text",
            "text": "The 13th: a whole day before Ana arrives, so that the Musee d'Orsay can wait for her on the 14th."
          }
        ]
      },
      {
        "role": "user",
        "content": "What is the weather in Paris?"
      }
    ],
    "stream": true,
    "tools": [
      {
        "name": "forecast",
        "description": "The forecast for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      },
      {
        "name": "alerts",
        "description": "Weather alerts for a city.",
        "input_schema": {
          "type": "object",
          "properties": {
            "city": {
              "type": "string"
            }
          },
          "required": [
            "city"
          ]
        }
      },
      {
        "name": "report",
        "description": "Today's weather report.",
        "input_schema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "thinking": {
      "type": "adaptive",
      "display": "summarized"
    },
    "output_config": {
      "effort": "high"
    }
  }
}
